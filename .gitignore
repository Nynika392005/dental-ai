# ============================================================
# DENTAL-AI — Root .gitignore
# ============================================================

# ----- Secrets & Environment --------------------------------
.env
.env.*
!.env.example
*.pem
*.key
*.p8
*.p12
*.jks
*.mobileprovision
secrets/

# ----- Python (dentai-backend) ------------------------------
__pycache__/
*.py[cod]
*$py.class
*.pyc
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
eggs/
parts/
var/
sdist/
develop-eggs/
.installed.cfg
/dentai-backend/lib/
lib64/
*.so

# Virtual environments
venv/
.venv/
env/
ENV/
.env/

# Database files
*.db
*.sqlite
*.sqlite3
*fallback.json

# Caching
.vite/

# Alembic (keep ini + migrations, ignore __pycache__ inside)
alembic/__pycache__/

# Scratch / test scripts
dentai-backend/scratch/

# ----- Node / React Native (dentai-mobile) ------------------
node_modules/
npm-debug.*
yarn-debug.*
yarn-error.*
.expo/
web-build/
dist/
expo-env.d.ts
*.tsbuildinfo
app-example/

# Native build artifacts (generated by EAS / expo prebuild)
/ios/
/android/
.kotlin/

# Metro
.metro-health-check*

# ----- Editors & OS -----------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
